{
  "kind": "collectionType",
  "collectionName": "users-permissions_user",
  "info": {
    "name": "user",
    "description": ""
  },
  "options": {
    "draftAndPublish": false,
    "timestamps": true
  },
  "attributes": {
    "username": {
      "type": "string",
      "minLength": 3,
      "unique": true,
      "configurable": false,
      "required": true
    },
    "email": {
      "type": "email",
      "minLength": 6,
      "configurable": false,
      "required": true
    },
    "provider": {
      "type": "string",
      "configurable": false
    },
    "password": {
      "type": "password",
      "minLength": 6,
      "configurable": false,
      "private": true
    },
    "resetPasswordToken": {
      "type": "string",
      "configurable": false,
      "private": true
    },
    "confirmationToken": {
      "type": "string",
      "configurable": false,
      "private": true
    },
    "confirmed": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "blocked": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "role": {
      "model": "role",
      "via": "users",
      "plugin": "users-permissions",
      "configurable": false
    },
    "assessmentCompleted": {
      "type": "boolean",
      "default": false
    },
    "isFirstLogin": {
      "type": "boolean",
      "default": true
    },
    "streetAddress1": {
      "type": "string"
    },
    "streetAddress2": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "firstName": {
      "type": "string"
    },
    "lastName": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "postalCode": {
      "type": "string"
    },
    "children": {
      "plugin": "users-permissions",
      "collection": "user",
      "via": "parents",
      "dominant": true
    },
    "parents": {
      "plugin": "users-permissions",
      "collection": "user",
      "via": "children"
    },
    "companies": {
      "via": "users",
      "collection": "company",
      "dominant": true
    },
    "securityRating": {
      "via": "user",
      "model": "security-rating"
    },
    "userActionItems": {
      "via": "user",
      "plugin": "cnc-core",
      "collection": "user-action-item"
    },
    "attempLogin": {
      "type": "integer",
      "private": true,
      "default": 0
    },
    "codeGeneratedLogs": {
      "private": true,
      "via": "user",
      "plugin": "cnc-core",
      "collection": "code-generated-log"
    },
    "staffAssignedCourses": {
      "via": "user",
      "collection": "staff-assigned-course"
    },
    "staffAssignedPolicies": {
      "via": "user",
      "collection": "staff-assigned-policy"
    },
    "activityTrackings": {
      "private": true,
      "via": "user",
      "plugin": "cnc-core",
      "collection": "activity-tracking"
    },
    "userQuestionGroups": {
      "via": "user",
      "plugin": "cnc-core",
      "collection": "user-question-group"
    },
    "gophishApiKey": {
      "type": "text"
    },
    "previousRole": {
      "plugin": "users-permissions",
      "model": "role"
    },
    "departmentId": {
      "model": "department"
    },
    "version": {
      "type": "enumeration",
      "enum": [
        "free",
        "full"
      ],
      "default": "free"
    },
    "isSelfRegistration": {
      "type": "boolean",
      "default": false
    },
    "isAckGuideTips": {
      "type": "boolean"
    },
    "gophishUserId": {
      "type": "string"
    },
    "periodEnd": {
      "type": "datetime"
    },
    "subscription": {
      "type": "string"
    }
  }
}
